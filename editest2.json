{
  "inputs": [
    {"path": "video1.mp4", "options": ["-ss", "1048", "-t", "8.5"]},
    {"path": "video1.mp4", "options": ["-ss", "800", "-t", "8"]},
    "NO BATIDÃO.mp4"
  ],
  "steps": [
    {
      "in": ["0:v"],
      "chain": [
        "fps=60",
        "scale=1096:1936:force_original_aspect_ratio=increase",
        "crop=1096:1936",
        "zoompan=z='min(1+0.28*on/120,1.28)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1096x1936:fps=60",
        "crop=1080:1920:x='8+8*sin(t*90)*between(t,0.4,0.65)':y='8+8*cos(t*110)*between(t,0.4,0.65)'",
        "eq=saturation=1.15:contrast=1.1",
        "drawbox=x=0:y=0:w=iw:h=ih:color=white@0.9:t=fill:enable='between(t,0.4,0.46)'",
        "drawtext=text='BRO CAN’T EVEN GET UP':fontsize=64:fontcolor=white:borderw=4:bordercolor=black:x=(w-text_w)/2:y=(h-text_h)/2:enable='between(t,0.2,2.5)'",
        "setsar=1",
        "format=yuv420p"
      ],
      "out": "v1"
    },
    {
      "in": ["0:a"],
      "chain": ["asetpts=PTS-STARTPTS", "aformat=sample_rates=48000:channel_layouts=stereo"],
      "out": "a1"
    },
    {
      "in": ["1:v"],
      "chain": [
        "fps=60",
        "scale=1096:1936:force_original_aspect_ratio=increase",
        "crop=1096:1936",
        "zoompan=z='min(1+0.12*on/180,1.12)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1096x1936:fps=60",
        "crop=1080:1920",
        "drawtext=text='WAIT FOR IT':fontsize=56:fontcolor=white:borderw=4:bordercolor=black:x=(w-text_w)/2:y=h-text_h-300:enable='between(t,1,3)'",
        "setsar=1",
        "format=yuv420p"
      ],
      "out": "v2"
    },
    {
      "in": ["1:a"],
      "chain": ["asetpts=PTS-STARTPTS", "aformat=sample_rates=48000:channel_layouts=stereo"],
      "out": "a2"
    },
    {
      "in": ["v1", "a1", "v2", "a2"],
      "filter": "concat",
      "args": "n=2:v=1:a=1",
      "out": ["vc", "ac"]
    },
    {
      "in": ["ac"],
      "filter": "asplit",
      "args": 2,
      "out": ["ao1", "ao2"]
    },
    {
      "in": ["2:a"],
      "chain": [
        "atrim=0:16.5",
        "asetpts=PTS-STARTPTS",
        "aformat=sample_rates=48000:channel_layouts=stereo",
        "volume=0.16",
        "afade=t=in:st=0:d=0.3",
        "afade=t=out:st=16:d=0.5"
      ],
      "out": "mus"
    },
    {
      "in": ["mus", "ao1"],
      "filter": "sidechaincompress",
      "args": "threshold=0.04:ratio=4:attack=20:release=300",
      "out": "duck"
    },
    {
      "in": ["ao2", "duck"],
      "chain": [
        "amix=inputs=2:duration=first:dropout_transition=0",
        "volume=2",
        "alimiter=limit=0.95"
      ],
      "out": "a"
    }
  ],
  "map": ["vc", "a"],
  "options": "-c:v libx264 -preset medium -crf 18 -r 60 -pix_fmt yuv420p -c:a aac -b:a 192k",
  "output": "edit"
}